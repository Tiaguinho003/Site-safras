---
import "../styles/global.css";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CookieConsent from "../components/layout/CookieConsent.astro";
import Analytics from "../components/layout/Analytics.astro";
import ConversionEvents from "../components/layout/ConversionEvents.astro";
import {
  CONSENT_COOKIE,
  CONSENT_VERSION,
  CONSENT_MAX_AGE,
  PERMANENTLY_DENIED,
} from "../data/consent";
import {
  getCurrentLocale,
  localizeURL,
  LOCALES,
  LOCALE_LABELS,
  DEFAULT_LOCALE,
  t,
} from "../i18n";

interface Props {
  title: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  canonical?: boolean;
  alternates?: boolean;
  noindex?: boolean;
  structuredData?: Record<string, unknown>;
}

const locale = getCurrentLocale(Astro);
const bcp47 = LOCALE_LABELS[locale].bcp47;

const {
  title,
  description = t("meta.siteDescription", locale),
  socialImage,
  socialImageAlt = t("meta.socialImageAlt", locale),
  socialImageWidth,
  socialImageHeight,
  canonical = true,
  alternates = true,
  noindex = false,
  structuredData,
} = Astro.props;

// SEO multi-idioma: hreflang alternates pra cada locale + x-default.
// Astro.site é a URL base (https://safrasenegocios.com.br).
const baseUrl = Astro.site ?? new URL("https://safrasenegocios.com.br");
const siteUrl = baseUrl.toString().replace(/\/$/, "");
const currentPath = Astro.url.pathname;
const canonicalHref = new URL(currentPath, baseUrl).href;
const socialImageHref = socialImage
  ? new URL(socialImage, baseUrl).href
  : undefined;
const hreflangs = LOCALES.map((l) => ({
  hreflang: LOCALE_LABELS[l].bcp47,
  href: siteUrl + localizeURL(currentPath, l),
}));
const xDefaultHref = siteUrl + localizeURL(currentPath, DEFAULT_LOCALE);
const languageOptions = LOCALES.map((targetLocale) => ({
  locale: targetLocale,
  browserBase: targetLocale === "pt-br" ? "pt" : targetLocale,
  href: localizeURL(currentPath, targetLocale),
  prompt: t("languageSuggestion.prompt", targetLocale),
  accept: t("languageSuggestion.accept", targetLocale),
  dismiss: t("languageSuggestion.dismiss", targetLocale),
}));

/**
 * Verificação de propriedade do Search Console.
 *
 * Método "tag HTML": o Google lê esta meta na home e libera a propriedade.
 * Escolhido por não exigir alteração na zona de DNS, que hoje serve a
 * produção — e por ser reversível removendo uma variável.
 *
 * Vazia enquanto o código de verificação não for gerado no painel. Sem a
 * variável, nenhuma meta é emitida.
 */
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION;

/**
 * Mesma chave que o Analytics.astro consulta. Aqui ela decide se o ouvinte
 * de eventos de conversão é servido: sem tag, não há o que receber evento.
 */
const ga4Enabled = Boolean(import.meta.env.PUBLIC_GA4_MEASUREMENT_ID);
---

<!doctype html>
<html lang={bcp47}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/*
      Bootstrap do consentimento — PRECISA ser o primeiro script da página.

      O Consent Mode exige que `gtag('consent','default', …)` rode ANTES de
      qualquer tag carregar. Não é preferência de estilo: é a diferença entre
      um sinal de consentimento válido e uma tag que já leu o navegador antes
      de perguntar. Por isso é `is:inline` (não passa pelo bundler, não é
      adiado) e vive aqui, e não num componente.

      O que este script estabelece é o contrato que o Analytics.astro consome:
      `window.__consent`, com get/set/onChange, e o sinal do Consent Mode.
      Nenhuma tag carrega a partir daqui.
    */}
    <script
      is:inline
      define:vars={{
        cookieName: CONSENT_COOKIE,
        version: CONSENT_VERSION,
        maxAge: CONSENT_MAX_AGE,
        permanentlyDenied: PERMANENTLY_DENIED,
      }}
    >
      (function () {
        var w = window;

        w.dataLayer = w.dataLayer || [];
        function gtag() {
          w.dataLayer.push(arguments);
        }
        w.gtag = w.gtag || gtag;

        function readCookie(name) {
          var match = document.cookie.match(
            new RegExp("(?:^|;\\s*)" + name + "=([^;]*)")
          );
          return match ? decodeURIComponent(match[1]) : null;
        }

        /* Espelha parseConsent() de src/data/consent.ts. A duplicação é
           deliberada: script inline não importa módulo, e o custo de manter
           dez linhas em dois lugares é menor que o de adiar este bootstrap. */
        function parse(raw) {
          if (!raw) return null;
          var params = new URLSearchParams(raw);
          var v = Number(params.get("v"));
          var t = Number(params.get("t"));
          var analytics = params.get("analytics");
          if (v !== version) return null;
          if (!isFinite(t) || t <= 0) return null;
          if (analytics !== "granted" && analytics !== "denied") return null;
          return { version: v, timestamp: t, analytics: analytics };
        }

        function write(state) {
          var value =
            "v=" + state.version + "&t=" + state.timestamp + "&analytics=" + state.analytics;
          document.cookie =
            cookieName +
            "=" +
            encodeURIComponent(value) +
            "; max-age=" + maxAge +
            "; path=/; SameSite=Lax" +
            (location.protocol === "https:" ? "; Secure" : "");
        }

        var stored = parse(readCookie(cookieName));
        var decided = stored !== null;
        var state = stored;

        /* Global Privacy Control: o visitante já declarou a escolha no
           navegador. Perguntar de novo seria ignorá-la. Registra a recusa e
           não exibe o banner — o link do rodapé continua disponível para
           quem quiser mudar de ideia. */
        var gpc = w.navigator && w.navigator.globalPrivacyControl === true;

        if (!decided && gpc) {
          state = {
            version: version,
            timestamp: Math.floor(Date.now() / 1000),
            analytics: "denied",
          };
          write(state);
          decided = true;
        }

        var analytics = state ? state.analytics : "denied";

        /* Sinais de publicidade ficam negados sempre. O site não faz
           publicidade nem remarketing, e nenhuma interface oferece essa
           chave — travar aqui impede que uma configuração descuidada do
           GA4 conceda o que nunca foi pedido. */
        var defaults = { analytics_storage: analytics };
        for (var i = 0; i < permanentlyDenied.length; i++) {
          defaults[permanentlyDenied[i]] = "denied";
        }
        gtag("consent", "default", defaults);

        var listeners = [];

        function snapshot() {
          return {
            analytics: analytics,
            decided: decided,
            timestamp: state ? state.timestamp : null,
          };
        }

        w.__consent = {
          get: snapshot,

          set: function (prefs) {
            var next =
              prefs && prefs.analytics === "granted" ? "granted" : "denied";
            state = {
              version: version,
              timestamp: Math.floor(Date.now() / 1000),
              analytics: next,
            };
            analytics = next;
            decided = true;
            write(state);

            gtag("consent", "update", { analytics_storage: next });

            for (var j = 0; j < listeners.length; j++) {
              try {
                listeners[j](snapshot());
              } catch (error) {
                /* Um listener quebrado não pode derrubar os demais. */
              }
            }
          },

          /* A Fase D assina aqui para carregar o GA4 quando — e só quando —
             houver permissão. Devolve a função de cancelamento. */
          onChange: function (callback) {
            listeners.push(callback);
            return function () {
              listeners = listeners.filter(function (fn) {
                return fn !== callback;
              });
            };
          },
        };
      })();
    </script>

    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#025c00" />
    {gscVerification && (
      <meta name="google-site-verification" content={gscVerification} />
    )}
    <link rel="icon" type="image/png" href="/favicon.png" />
    {canonical && <link rel="canonical" href={canonicalHref} />}
    {/* hreflang alternates pra SEO multi-idioma */}
    {alternates && hreflangs.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    {alternates && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />}

    <title>{title}</title>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Safras & Negócios" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:locale" content={bcp47.replace("-", "_")} />
    {LOCALES.filter((item) => item !== locale).map((item) => (
      <meta
        property="og:locale:alternate"
        content={LOCALE_LABELS[item].bcp47.replace("-", "_")}
      />
    ))}
    {socialImageHref && <meta property="og:image" content={socialImageHref} />}
    {socialImageHref && <meta property="og:image:alt" content={socialImageAlt} />}
    {socialImageHref && socialImageWidth && (
      <meta property="og:image:width" content={String(socialImageWidth)} />
    )}
    {socialImageHref && socialImageHeight && (
      <meta property="og:image:height" content={String(socialImageHeight)} />
    )}
    <meta
      name="twitter:card"
      content={socialImageHref ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImageHref && <meta name="twitter:image" content={socialImageHref} />}
    {socialImageHref && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {structuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )}

  </head>
  <body class="flex flex-col min-h-screen">
    <aside
      id="language-suggestion"
      class="fixed inset-x-4 top-4 z-[80] mx-auto max-w-2xl rounded-2xl border border-line bg-paper/95 p-4 shadow-xl backdrop-blur-md md:flex md:items-center md:gap-5 md:px-5"
      role="status"
      aria-live="polite"
      hidden
    >
      <p
        class="flex-1 text-sm font-medium text-ink"
        data-language-suggestion-prompt
      ></p>
      <div class="mt-3 flex flex-wrap items-center gap-2 md:mt-0">
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-full bg-brand px-4 py-2 text-sm font-semibold text-paper transition-colors hover:bg-brand-dark focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          data-language-suggestion-accept
        ></a>
        <button
          type="button"
          class="inline-flex min-h-11 items-center justify-center rounded-full px-4 py-2 text-sm font-medium text-ink-muted transition-colors hover:bg-paper-alt hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
          data-language-suggestion-dismiss
        ></button>
      </div>
    </aside>

    <script is:inline define:vars={{ locale, languageOptions }}>
      (function () {
        try {
          if (/(?:^|;\s*)safras_locale=/.test(document.cookie)) return;
          if (sessionStorage.getItem("safras_language_suggestion_dismissed")) return;

          var languages =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || "pt-BR"];
          var target = null;

          for (var i = 0; i < languages.length; i++) {
            var base = (languages[i] || "").toLowerCase().split("-")[0];
            var candidate = languageOptions.find(function (option) {
              return option.browserBase === base;
            });
            if (candidate) {
              target = candidate;
              break;
            }
          }

          if (!target || target.locale === locale) return;

          var banner = document.getElementById("language-suggestion");
          if (!banner) return;
          var prompt = banner.querySelector("[data-language-suggestion-prompt]");
          var accept = banner.querySelector("[data-language-suggestion-accept]");
          var dismiss = banner.querySelector("[data-language-suggestion-dismiss]");
          if (!prompt || !accept || !dismiss) return;

          prompt.textContent = target.prompt;
          accept.textContent = target.accept;
          accept.setAttribute("href", target.href + window.location.hash);
          dismiss.textContent = target.dismiss;
          banner.hidden = false;

          accept.addEventListener("click", function () {
            document.cookie =
              "safras_locale=" +
              encodeURIComponent(target.locale) +
              "; path=/; max-age=31536000; SameSite=Lax";
          });
          dismiss.addEventListener("click", function () {
            sessionStorage.setItem("safras_language_suggestion_dismissed", "1");
            banner.hidden = true;
          });
        } catch (error) {
          // A sugestão é progressiva; qualquer falha mantém a URL solicitada.
        }
      })();
    </script>

    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-brand focus:text-paper focus:px-4 focus:py-2 focus:rounded-md focus:font-medium"
      href="#conteudo"
    >
      {t("common.skipToContent", locale)}
    </a>

    <Header />

    <main id="conteudo" class="flex-1">
      <slot />
    </main>

    <Footer />

    <CookieConsent />

    {/* Depois do banner: o GA4 só carrega se houver permissão, e o
        componente não emite nada enquanto PUBLIC_GA4_MEASUREMENT_ID
        estiver vazia. */}
    <Analytics />

    {/* Eventos de conversão. Só existe quando há tag para recebê-los; o
        despacho em si continua condicionado ao consentimento, dentro do
        track() em src/data/analytics.ts. */}
    {ga4Enabled && <ConversionEvents />}

    <script>
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      );

      /* ===== Smooth-scroll unificado pra anchors/buttons =====
         Offset calibrado pra section.top cair ABAIXO da linha de trigger do
         scroll-spy (100px) — assim a seção ativa o estado verde no header.
         Usa a rolagem nativa e respeita reduced-motion. */
      const getScrollOffset = (): number =>
        window.matchMedia("(min-width: 768px)").matches ? -90 : -70;

      const smoothScrollTo = (target: HTMLElement | number) => {
        const top =
          typeof target === "number"
            ? target
            : target.getBoundingClientRect().top +
              window.scrollY +
              getScrollOffset();
        window.scrollTo({
          top,
          behavior: reducedMotion.matches ? "auto" : "smooth",
        });
      };

      // Expõe pra Footer "Topo", hero "Explorar Serviços", scroll-next etc.
      (window as Window & { __smoothScrollTo?: typeof smoothScrollTo }).__smoothScrollTo =
        smoothScrollTo;

      // Intercepta TODOS os cliques em anchors da mesma página
      document.addEventListener("click", (e) => {
        if (e.ctrlKey || e.metaKey || e.shiftKey) return;
        const target = e.target as Element | null;
        if (!target) return;

        const link = target.closest('a[href*="#"]') as HTMLAnchorElement | null;
        if (!link) return;
        if (link.target === "_blank") return;
        if (link.hasAttribute("download")) return;

        const href = link.getAttribute("href");
        if (!href) return;

        let url: URL;
        try {
          url = new URL(href, window.location.href);
        } catch {
          return;
        }

        // Só intercepta anchors da MESMA página. Normaliza trailing slash
        // (config tem trailingSlash:"never", mas links podem ter "/").
        const normalize = (p: string) => p.replace(/\/$/, "") || "/";
        if (normalize(url.pathname) !== normalize(window.location.pathname))
          return;
        if (!url.hash || url.hash === "#") return;

        const id = decodeURIComponent(url.hash.slice(1));
        const targetEl = document.getElementById(id);
        if (!targetEl) return;

        e.preventDefault();
        smoothScrollTo(targetEl);

        // Atualiza URL sem disparar scroll nativo
        if (history.pushState) {
          history.pushState(null, "", url.hash);
        }
      });
    </script>
  </body>
</html>
