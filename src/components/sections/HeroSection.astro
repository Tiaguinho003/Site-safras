---
/**
 * HeroSection — hero da home nos três idiomas (versão "Painel", set/2026).
 *
 * Painel verde com o texto à esquerda e a foto à direita; no mobile a foto
 * vai para baixo. Um selo giratório senta na junção entre o verde e a foto,
 * e um ramo de café fica em marca d'água atrás do texto. Substitui o hero
 * anterior, com foto de fundo e palavras rotativas.
 *
 * A foto é um carrossel ambiente (set/2026): seis fotos em fusão lenta, com
 * um zoom quase imperceptível. Só a primeira entra no HTML carregável — as
 * demais nascem `hidden` e o script as libera uma a uma, já decodificadas,
 * antes de cada troca, para não pesar no carregamento. Um botão discreto
 * pausa e retoma; com `prefers-reduced-motion` o carrossel nasce pausado e
 * as trocas são instantâneas.
 *
 * Strings: `dict.hero.*`. Anchors: `hero` (id da seção), `contato` (CTA
 * principal) e `servicos` (link secundário, só no desktop).
 *
 * Responsivo pela Camada 1 (utilities + variants `md:`); o único conteúdo
 * que muda entre os lados é o sobretítulo e o texto do selo, curtos demais
 * para justificar dois componentes.
 */
import { Image } from "astro:assets";
import { useTranslation, getAnchor } from "../../i18n";
import heroPhoto from "../../assets/hero/hero-prova-de-xicara.jpg";
import heroPeneira from "../../assets/hero/hero-peneira-graos.jpg";
import heroGraosXicara from "../../assets/hero/hero-graos-e-xicara.jpg";
import heroTorra from "../../assets/hero/hero-torra.jpg";
import heroColheres from "../../assets/hero/hero-prova-colheres.jpg";
import heroFachada from "../../assets/hero/hero-fachada-placa.jpg";
import ramoCafe from "../../assets/hero/ramo-cafe.png";
// Variante do logo com o verde da marca (#025c00), a mesma do header.
import logoRaw from "../../assets/branding/safras-logo-completo-escuro.svg?raw";

const { t, tArray, locale, localizeAnchor } = useTranslation(Astro);
const heroId = getAnchor("hero", locale);
const contactHref = localizeAnchor("contato");
const servicesHref = localizeAnchor("servicos");

/**
 * Fotos do carrossel, na ordem de exibição. A primeira é o LCP da página e
 * continua `eager`; o `alt` dela é `hero.photoAlt`, os demais vêm de
 * `hero.slidesAlt`, na mesma ordem. `position` é o object-position que
 * mantém o assunto visível nos dois recortes (retrato no desktop, paisagem
 * no mobile).
 */
const slidesAlt = tArray<string>("hero.slidesAlt");
const slides = [
  { src: heroPhoto, alt: t("hero.photoAlt"), position: "center" },
  { src: heroPeneira, alt: slidesAlt[0], position: "45% 55%" },
  { src: heroGraosXicara, alt: slidesAlt[1], position: "40% 50%" },
  { src: heroTorra, alt: slidesAlt[2], position: "50% 45%" },
  { src: heroColheres, alt: slidesAlt[3], position: "50% 50%" },
  { src: heroFachada, alt: slidesAlt[4], position: "60% 40%" },
];

// Miolo do selo: o símbolo da marca (folha e tronco) lido do SVG oficial,
// para não duplicar os caminhos nem sair de sincronia com o logo.
const SYMBOL_PATHS = Array.from(
  logoRaw.matchAll(/<path fill="(#[0-9A-Fa-f]{6})"[^>]*? d="([^"]+)"/g)
).slice(0, 2);
// Recorte do símbolo dentro do viewBox do logo completo.
const SYMBOL_BOX = { x: 104, y: 429, w: 233, h: 333 };

const escapeHtml = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

/**
 * Selo circular: texto correndo num anel e o símbolo no centro. O texto
 * termina em " · " e é esticado ao comprimento exato do anel, de modo que
 * fecha o círculo em qualquer idioma.
 */
function seal(size: number, id: string, text: string): string {
  const r = size / 2;
  const ring = r * 0.74;
  const scale = (size * 0.42) / SYMBOL_BOX.h;
  const cx = SYMBOL_BOX.x + SYMBOL_BOX.w / 2;
  const cy = SYMBOL_BOX.y + SYMBOL_BOX.h / 2;
  const ringPath = `M${r},${r} m-${ring},0 a${ring},${ring} 0 1,1 ${ring * 2},0 a${ring},${ring} 0 1,1 -${ring * 2},0`;
  const symbol = SYMBOL_PATHS.map(
    ([, fill, d]) => `<path d="${d}" fill="${fill}" fill-rule="evenodd"/>`
  ).join("");
  const textLength = Math.round(2 * Math.PI * ring - 4);
  return (
    `<svg viewBox="0 0 ${size} ${size}" width="${size}" height="${size}" aria-hidden="true" focusable="false">` +
    `<circle cx="${r}" cy="${r}" r="${r}" style="fill: var(--color-paper-alt)"/>` +
    `<defs><path id="${id}" d="${ringPath}"/></defs>` +
    `<text font-size="${(size * 0.062).toFixed(2)}" font-weight="600" letter-spacing="1.4" style="fill: var(--color-brand)">` +
    `<textPath href="#${id}" textLength="${textLength}" lengthAdjust="spacing">${escapeHtml(text)}</textPath></text>` +
    `<g transform="translate(${(r - scale * cx).toFixed(2)} ${(r - scale * cy).toFixed(2)}) scale(${scale.toFixed(4)})">${symbol}</g>` +
    `</svg>`
  );
}

const sealMobile = seal(80, "hero-selo-m", t("hero.sealMobile"));
const sealDesktop = seal(150, "hero-selo-d", t("hero.seal"));
---

<section id={heroId} class="hero" aria-labelledby="hero-titulo">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__ramo" aria-hidden="true">
    <Image
      src={ramoCafe}
      alt=""
      widths={[700, 1000, 1400]}
      sizes="(min-width: 768px) 66vw, 177vw"
      loading="eager"
      fetchpriority="low"
      quality={80}
    />
  </div>

  <div class="hero__copy">
    <p
      class="hero__rise mb-5 text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-tint md:mb-6 xl:text-xs"
      style="animation-delay: 60ms;"
    >
      <span class="md:hidden">{t("hero.eyebrowMobile")}</span>
      <span class="hidden md:inline">{t("hero.eyebrow")}</span>
    </p>

    <h1
      id="hero-titulo"
      class="hero__rise hero__title font-medium leading-[1.04] tracking-[-0.035em] text-paper"
      style="animation-delay: 160ms;"
    >
      {t("hero.title.lead")} <span class="uppercase">{t("hero.title.coffee")}</span><br />
      {t("hero.title.mid")} <span class="uppercase">{t("hero.title.market")}</span>
    </h1>

    <p
      class="hero__rise hero__text mt-7 max-w-[520px] leading-[1.55] text-paper/78 md:mt-6"
      style="animation-delay: 260ms;"
    >
      {t("hero.description")}
    </p>

    <div
      class="hero__rise mt-9 flex flex-wrap items-center gap-x-7 gap-y-4 md:mt-8"
      style="animation-delay: 360ms;"
    >
      <a
        href={contactHref}
        data-radial-button
        class="hero__cta group relative inline-flex items-center gap-1.5 overflow-hidden whitespace-nowrap rounded-full border-2 border-transparent bg-paper-alt px-8 py-[15px] text-base font-medium text-brand-dark shadow-lg transition-[color,background-color] duration-[600ms] hover:text-paper md:px-6 md:py-2.5"
      >
        <span class="relative z-10">{t("hero.cta")}</span>
        <span
          aria-hidden="true"
          class="relative z-10 transition-transform duration-[600ms] group-hover:translate-x-1"
        >→</span>
        <span
          aria-hidden="true"
          data-radial-fill
          style="left: 50%; top: 50%; transition: width 800ms ease-in-out;"
          class="absolute z-0 block aspect-square w-0 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand group-hover:w-[225%]"
        ></span>
      </a>

      <a
        href={servicesHref}
        class="hero__link hidden items-center gap-1.5 whitespace-nowrap text-base font-medium text-paper underline decoration-1 underline-offset-[6px] transition-[color] hover:text-brand-tint md:inline-flex"
      >
        <span>{t("hero.secondary")}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="hero__media">
    <div
      class="hero__photo"
      role="group"
      aria-label={t("hero.carouselAriaLabel")}
      data-hero-carousel
      data-interval="6000"
    >
      {
        slides.map((slide, i) => (
          <div
            class="hero__slide"
            data-hero-slide
            data-active={i === 0 ? "true" : "false"}
            aria-hidden={i === 0 ? undefined : "true"}
            hidden={i !== 0}
          >
            <Image
              src={slide.src}
              alt={slide.alt}
              widths={i === 0 ? [480, 720, 960, 1200, 1600] : [480, 720, 960, 1200]}
              sizes="(min-width: 768px) 45vw, 100vw"
              class="hero__img"
              style={`object-position: ${slide.position};`}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : "low"}
              decoding={i === 0 ? "auto" : "async"}
              quality={i === 0 ? 78 : 72}
            />
          </div>
        ))
      }
      <button
        type="button"
        class="hero__pause"
        data-hero-toggle
        data-state="playing"
        aria-label={t("hero.carouselPause")}
        data-label-pause={t("hero.carouselPause")}
        data-label-play={t("hero.carouselPlay")}
      >
        <svg class="hero__pause-icon hero__pause-icon--pause" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <rect x="6" y="5" width="4" height="14" rx="1" />
          <rect x="14" y="5" width="4" height="14" rx="1" />
        </svg>
        <svg class="hero__pause-icon hero__pause-icon--play" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13a1 1 0 0 0 1.52.86l10.2-6.5a1 1 0 0 0 0-1.72L9.52 4.64A1 1 0 0 0 8 5.5Z" />
        </svg>
      </button>
    </div>
    <div class="hero__seal hero__seal--mobile md:hidden" aria-hidden="true" set:html={sealMobile} />
    <div class="hero__seal hero__seal--desktop hidden md:block" aria-hidden="true" set:html={sealDesktop} />
  </div>
</section>

<style>
  /* ===========================================================
     Hero "Painel". Mobile: texto em cima, foto embaixo.
     Desktop (md+): texto em 58% da largura no tablet e 55% a partir de lg;
     a foto ocupa o restante.
     A altura mínima segue a viewport, descontada a barra superior,
     e nunca fica menor que o conteúdo.
     =========================================================== */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--site-header-h));
    overflow: hidden;
    background-color: var(--color-brand-dark);
    color: var(--color-paper);
  }

  /* Luz verde difusa atrás do texto */
  .hero__glow {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 60%;
    z-index: 0;
    background: radial-gradient(
      420px 320px at 20% 30%,
      rgba(2, 92, 0, 0.6),
      rgba(1, 61, 1, 0) 70%
    );
    pointer-events: none;
  }

  /* Ramo de café em marca d'água. As posições vêm do desenho aprovado,
     em proporção ao painel; a imagem é um PNG com transparência. */
  .hero__ramo {
    position: absolute;
    left: 27%;
    top: -46%;
    width: 177%;
    z-index: 1;
    opacity: 0.07;
    pointer-events: none;
  }
  .hero__ramo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero__copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    align-items: flex-start;
    padding: 56px 24px 72px;
  }
  /* Tamanhos calibrados para a primeira linha ("Conectando seu CAFÉ")
     caber inteira em cada idioma; medidas na Inter servida pelo site,
     que não tem eixo óptico e é um pouco mais larga que a do desenho. */
  .hero__title {
    font-size: clamp(1.625rem, 8.2vw, 2rem);
  }
  .hero__title:lang(en) {
    font-size: clamp(1.5rem, 7.4vw, 1.8125rem);
  }
  .hero__title:lang(es) {
    font-size: clamp(1.75rem, 8.7vw, 2.125rem);
  }
  .hero__text {
    font-size: 1rem;
    text-wrap: pretty;
  }

  /* Foto com o canto superior esquerdo arredondado e uma sombra leve
     na junção com o verde. */
  .hero__media {
    position: relative;
    z-index: 2;
    flex: none;
    height: 310px;
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-top-left-radius: 64px;
    background-color: var(--color-brand-dark);
    box-shadow:
      0 -12px 24px -6px rgba(0, 0, 0, 0.22),
      0 -2px 6px rgba(0, 0, 0, 0.1);
  }
  .hero__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /* Carrossel: a foto que entra se funde por cima da atual (que só some
     depois, escondida atrás), então o brilho nunca cai no meio da troca.
     O zoom lento começa quando o script marca `is-live`, para a primeira
     foto também deslizar a partir do repouso. */
  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1800ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .hero__slide[data-active="true"] {
    opacity: 1;
    z-index: 2;
  }
  .hero__slide[data-previous="true"] {
    opacity: 1;
    z-index: 1;
    transition: none;
  }
  .hero__slide .hero__img {
    transform: scale(1);
    transition: transform 9s linear;
  }
  .is-live .hero__slide[data-active="true"] .hero__img {
    transform: scale(1.06);
  }

  /* Pausar/retomar: botão discreto no canto da foto */
  .hero__pause {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.28);
    background-color: rgba(20, 19, 17, 0.35);
    color: var(--color-paper);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      background-color 200ms ease,
      transform 200ms ease;
  }
  .hero__pause:hover {
    background-color: rgba(20, 19, 17, 0.55);
  }
  .hero__pause:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }
  .hero__pause-icon--play {
    display: none;
    margin-left: 2px;
  }
  .hero__pause[data-state="paused"] .hero__pause-icon--pause {
    display: none;
  }
  .hero__pause[data-state="paused"] .hero__pause-icon--play {
    display: block;
  }

  /* Selo giratório na junção verde/foto */
  /* O invólucro só posiciona (translate); quem gira é o SVG interno.
     Animar rotate() no mesmo transform do translate faz o navegador
     interpolar por matriz: o selo desliza em vez de girar. */
  .hero__seal {
    position: absolute;
    z-index: 4;
    pointer-events: none;
  }
  .hero__seal :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 50%;
    animation: hero-spin 48s linear infinite;
  }
  .hero__seal--mobile {
    left: 24px;
    top: 0;
    width: 80px;
    height: 80px;
    transform: translateY(-50%);
  }

  /* Foco visível sobre o verde. A regra global de foco (global.css) fica
     fora de camada e vence as utilities do Tailwind, então o anel branco
     é definido aqui, com especificidade maior. */
  .hero__cta:focus-visible,
  .hero__link:focus-visible {
    outline-color: var(--color-paper);
  }
  .hero__link:focus-visible {
    outline-offset: 4px;
  }

  /* Entrada escalonada do texto ao carregar */
  .hero__rise {
    animation: hero-rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes hero-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (min-width: 768px) {
    .hero {
      flex-direction: row;
      min-height: clamp(600px, calc(100svh - var(--site-header-h)), 900px);
    }
    .hero__glow {
      width: 58%;
      height: 100%;
      background: radial-gradient(
        760px 520px at 22% 30%,
        rgba(2, 92, 0, 0.55),
        rgba(1, 61, 1, 0) 70%
      );
    }
    .hero__ramo {
      left: 20%;
      top: -42%;
      width: 66%;
    }
    .hero__copy {
      flex: 0 0 58%;
      width: 58%;
      justify-content: center;
      padding: 48px 2rem 104px clamp(1.5rem, 5vw, 4.5rem);
    }
    .hero__title {
      font-size: clamp(2rem, 4.4vw, 4rem);
    }
    .hero__title:lang(en) {
      font-size: clamp(1.75rem, 3.95vw, 3.6875rem);
    }
    .hero__title:lang(es) {
      font-size: clamp(2rem, 4.4vw, 4rem);
    }
    .hero__text {
      font-size: clamp(1.0625rem, 1.3vw, 1.1875rem);
    }
    .hero__media {
      flex: 0 0 42%;
      width: 42%;
      height: auto;
    }
    .hero__photo {
      border-top-left-radius: 120px;
      box-shadow:
        -14px 0 28px -6px rgba(0, 0, 0, 0.22),
        -2px 0 6px rgba(0, 0, 0, 0.1);
    }
    .hero__seal--desktop {
      left: 0;
      top: 65%;
      width: 120px;
      height: 120px;
      transform: translate(-50%, -50%);
    }
  }
  @media (min-width: 1024px) {
    .hero__glow {
      width: 55%;
    }
    .hero__copy {
      flex-basis: 55%;
      width: 55%;
    }
    .hero__media {
      flex-basis: 45%;
      width: 45%;
    }
    .hero__seal--desktop {
      width: 150px;
      height: 150px;
    }
  }

  @media (min-width: 768px) {
    .hero__pause {
      right: 24px;
      bottom: 24px;
    }
  }

  /* O selo giratório vira estático, o texto entra sem animação e as fotos
     trocam sem fusão nem zoom (o carrossel nasce pausado; ver script). */
  @media (prefers-reduced-motion: reduce) {
    .hero__seal :global(svg),
    .hero__rise {
      animation: none;
    }
    .hero__slide,
    .hero__slide .hero__img,
    .hero__pause {
      transition: none;
    }
    .is-live .hero__slide[data-active="true"] .hero__img {
      transform: none;
    }
  }
</style>

<script>
  // ---------- Carrossel ambiente do hero ----------
  // Só a primeira foto vem carregável; as outras nascem `hidden` e são
  // liberadas (e decodificadas) uma troca antes de aparecer. Pausa fora da
  // viewport, com a aba oculta e pelo botão; com prefers-reduced-motion
  // nasce pausado e, se o usuário retomar, troca sem transição (CSS).
  const carousel = document.querySelector<HTMLElement>("[data-hero-carousel]");
  if (carousel) {
    const slides = Array.from(
      carousel.querySelectorAll<HTMLElement>("[data-hero-slide]")
    );
    const toggle = carousel.querySelector<HTMLButtonElement>("[data-hero-toggle]");
    const interval = Number(carousel.dataset.interval) || 6000;
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let index = 0;
    let timer: number | null = null;
    let paused = reduceMotion;
    let inView = true;
    let pageVisible = !document.hidden;

    const setToggle = () => {
      if (!toggle) return;
      toggle.dataset.state = paused ? "paused" : "playing";
      const label = paused ? toggle.dataset.labelPlay : toggle.dataset.labelPause;
      if (label) toggle.setAttribute("aria-label", label);
    };

    // Libera a foto e espera a decodificação, para a fusão não piscar.
    const prepare = (i: number): Promise<void> => {
      const slide = slides[i];
      if (!slide) return Promise.resolve();
      if (slide.hasAttribute("hidden")) slide.removeAttribute("hidden");
      const img = slide.querySelector("img");
      if (img && typeof img.decode === "function") {
        return img.decode().catch(() => undefined);
      }
      return Promise.resolve();
    };

    const show = async (next: number) => {
      if (next === index) return;
      await prepare(next);
      const current = slides[index];
      const incoming = slides[next];
      current.dataset.previous = "true";
      current.dataset.active = "false";
      current.setAttribute("aria-hidden", "true");
      incoming.dataset.active = "true";
      incoming.removeAttribute("aria-hidden");
      index = next;
      // A anterior fica opaca atrás até a fusão terminar (1,8 s no CSS).
      window.setTimeout(() => {
        delete current.dataset.previous;
      }, 2000);
      // Adianta a seguinte, para a próxima troca já encontrá-la pronta.
      void prepare((next + 1) % slides.length);
    };

    const clear = () => {
      if (timer !== null) {
        window.clearTimeout(timer);
        timer = null;
      }
    };
    const schedule = () => {
      clear();
      if (paused || !inView || !pageVisible || slides.length < 2) return;
      timer = window.setTimeout(async () => {
        await show((index + 1) % slides.length);
        schedule();
      }, interval);
    };

    toggle?.addEventListener("click", () => {
      paused = !paused;
      setToggle();
      if (!paused) void prepare((index + 1) % slides.length);
      schedule();
    });
    document.addEventListener("visibilitychange", () => {
      pageVisible = !document.hidden;
      schedule();
    });
    new IntersectionObserver(
      (entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
        schedule();
      },
      { threshold: 0.15 }
    ).observe(carousel);

    setToggle();
    requestAnimationFrame(() => carousel.classList.add("is-live"));

    // A segunda foto só começa a baixar depois do load, fora do caminho do LCP.
    const warm = () => {
      if (!paused) void prepare(1);
      schedule();
    };
    if (document.readyState === "complete") warm();
    else window.addEventListener("load", warm, { once: true });
  }
</script>
