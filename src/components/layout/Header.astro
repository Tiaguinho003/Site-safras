---
import logoCompleto from "../../assets/branding/safras-logo-completo-escuro.svg";
import { mainNav } from "../../data/navigation";
import { useTranslation, DEFAULT_LOCALE } from "../../i18n";
import LanguageSwitcher from "./LanguageSwitcher.astro";

const { t, locale, localizeAnchor } = useTranslation(Astro);

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
// É a home da língua atual? (/, /en, /es)
const localeHomeForCurrent =
  locale === DEFAULT_LOCALE ? "/" : `/${locale}`;
const isHome =
  currentPath === localeHomeForCurrent ||
  currentPath === `${localeHomeForCurrent}/`;

const heroHref = localizeAnchor("hero");
const contactHref = localizeAnchor("contato");
---

{
  isHome && (
    <header
      data-header-hero
      class="site-header site-header--hero"
      aria-label={t("nav.heroHeaderAriaLabel")}
    >
      <div class="site-header__inner max-w-[100rem] mx-auto flex items-center justify-between gap-6">
        <a
          href={heroHref}
          class="site-header__logo flex items-center shrink-0"
          aria-label={t("nav.logoAriaLabel")}
        >
          <img
            src={logoCompleto.src}
            alt={t("brand.logoAlt")}
            width={logoCompleto.width}
            height={logoCompleto.height}
            class="site-header__logo-img w-auto"
            loading="eager"
          />
        </a>

        <nav aria-label={t("nav.mainMenu")} class="hidden lg:block flex-1">
          <ul class="flex items-center justify-center gap-10 lg:gap-14">
            {mainNav.map((item) => (
              <li>
                <a
                  data-nav-link
                  href={localizeAnchor(item.anchor)}
                  class="site-header__nav-link inline-flex flex-col items-center gap-1.5 text-base font-medium tracking-wide"
                >
                  <span>{t(item.labelKey)}</span>
                  <span class="site-header__nav-dot" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="flex items-center gap-3 shrink-0">
          <a
            href={contactHref}
            data-radial-button
            class="site-header__cta group relative hidden sm:inline-flex items-center gap-1.5 text-base font-medium px-6 py-2.5 rounded-full overflow-hidden"
          >
            <span class="relative z-10">{t("nav.cta")}</span>
            <span
              aria-hidden="true"
              class="relative z-10 transition-transform duration-[600ms] group-hover:translate-x-1"
            >→</span>
            <span
              aria-hidden="true"
              data-radial-fill
              style="left: 50%; top: 50%; transition: width 800ms ease-in-out;"
              class="site-header__cta-radial absolute z-0 block aspect-square w-0 -translate-x-1/2 -translate-y-1/2 rounded-full group-hover:w-[225%]"
            ></span>
          </a>

          {/* Language switcher — só desktop (mobile fica no hamburger menu) */}
          <div class="hidden lg:block">
            <LanguageSwitcher />
          </div>

          <button
            type="button"
            class="js-menu-toggle site-header__menu-btn lg:hidden p-2 -m-2"
            aria-label={t("common.openMenu")}
            data-label-open={t("common.openMenu")}
            data-label-close={t("common.closeMenu")}
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <svg
              class="w-7 h-7"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path class="site-header__menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /><path class="site-header__menu-icon-x" stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" />
            </svg>
          </button>
        </div>
      </div>
    </header>
  )
}

<header
  data-header-sticky
  data-scroll-aware={isHome ? "true" : undefined}
  data-visible={isHome ? "false" : "true"}
  aria-hidden={isHome ? "true" : undefined}
  inert={isHome ? true : undefined}
  class="site-header site-header--sticky"
>
  <div class="site-header__inner max-w-[100rem] mx-auto flex items-center justify-between gap-6">
    <a
      href={heroHref}
      class="site-header__logo flex items-center shrink-0"
      aria-label={t("nav.logoAriaLabel")}
    >
      <img
        src={logoCompleto.src}
        alt={t("brand.logoAlt")}
        width={logoCompleto.width}
        height={logoCompleto.height}
        class="site-header__logo-img w-auto"
        loading="eager"
      />
    </a>

    <nav aria-label={t("nav.mainMenu")} class="hidden lg:block flex-1">
      <ul class="flex items-center justify-center gap-10 lg:gap-14">
        {
          mainNav.map((item) => (
            <li>
              <a
                data-nav-link
                href={localizeAnchor(item.anchor)}
                class="site-header__nav-link inline-flex flex-col items-center gap-1.5 text-base font-medium tracking-wide"
              >
                <span>{t(item.labelKey)}</span>
                <span class="site-header__nav-dot" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <a
        href={contactHref}
        data-radial-button
        class="site-header__cta group relative hidden sm:inline-flex items-center gap-1.5 text-base font-medium px-6 py-2.5 rounded-full overflow-hidden"
      >
        <span class="relative z-10">{t("nav.cta")}</span>
        <span
          aria-hidden="true"
          class="relative z-10 transition-transform duration-[600ms] group-hover:translate-x-1"
        >→</span>
        <span
          aria-hidden="true"
          data-radial-fill
          style="left: 50%; top: 50%; transition: width 800ms ease-in-out;"
          class="site-header__cta-radial absolute z-0 block aspect-square w-0 -translate-x-1/2 -translate-y-1/2 rounded-full group-hover:w-[225%]"
        ></span>
      </a>

      {/* Language switcher — só desktop */}
      <div class="hidden lg:block">
        <LanguageSwitcher />
      </div>

      <button
        type="button"
        class="js-menu-toggle site-header__menu-btn lg:hidden p-2 -m-2"
        aria-label={t("common.openMenu")}
        data-label-open={t("common.openMenu")}
        data-label-close={t("common.closeMenu")}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg
          class="w-7 h-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path class="site-header__menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" /><path class="site-header__menu-icon-x" stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Menu mobile. Vive fora dos headers para que qualquer hambúrguer (hero
     ou sticky) o controle. O backdrop escurece e desfoca a página; o painel é
     um cartão de vidro fosco. Clique fora, Esc e resize ≥ lg fecham. -->
<div id="mobile-menu" hidden class="site-mobile-menu lg:hidden">
  <div class="site-mobile-menu__backdrop" aria-hidden="true"></div>
  <nav aria-label={t("nav.mobileMenuAriaLabel")} class="site-mobile-menu__panel">
    <ul class="site-mobile-menu__list" role="list">
      {
        mainNav.map((item, i) => (
          <li class="site-mobile-menu__item" style={`--i: ${i}`}>
            <a
              data-nav-link
              href={localizeAnchor(item.anchor)}
              class="site-mobile-link"
            >
              <span class="site-mobile-link__dot" aria-hidden="true"></span>
              <span class="site-mobile-link__label">{t(item.labelKey)}</span>
              <span class="site-mobile-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div
      class="site-mobile-menu__item site-mobile-menu__cta sm:hidden"
      style={`--i: ${mainNav.length}`}
    >
      <a
        href={contactHref}
        class="w-full inline-flex items-center justify-center gap-1.5 bg-brand hover:bg-brand-dark text-paper text-base font-medium px-5 py-3 rounded-full transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
      >
        {t("nav.cta")}
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div
      class="site-mobile-menu__item site-mobile-menu__lang"
      style={`--i: ${mainNav.length + 1}`}
    >
      <LanguageSwitcher mode="inline" />
    </div>
  </nav>
</div>

<style>
  /* ===========================================================
     Two-layer header. A barra em fluxo (`--hero`) abre a home e a
     barra fixa (`--sticky`) entra na rolagem, com a mesma aparência:
     fundo branco, logo colorida, CTA verde. Active state e fechamento
     do mobile menu são client-side (scroll spy), já que o site é
     single-page com anchors.
     =========================================================== */

  .site-header {
    width: 100%;
    left: 0;
    right: 0;
    background-color: var(--color-paper);
    border-bottom: 1px solid var(--color-line);
    --header-h: var(--site-header-h);
    --header-px: 1.5rem;
    --logo-h: 36px;
  }
  @media (min-width: 768px) {
    .site-header {
      --header-px: 2.5rem;
      --logo-h: 44px;
    }
  }
  @media (min-width: 1024px) {
    .site-header {
      --header-px: 3.5rem;
    }
  }

  /* A borda inferior entra na altura total, que é o que o hero desconta. */
  .site-header__inner {
    height: calc(var(--header-h) - 1px);
    padding-inline: var(--header-px);
  }

  .site-header__logo-img {
    height: var(--logo-h);
  }

  .site-header .site-header__nav-link {
    color: var(--color-ink-muted);
  }
  .site-header .site-header__nav-link:hover {
    color: var(--color-ink);
  }
  .site-header .site-header__nav-link[data-active] {
    color: var(--color-brand);
  }
  .site-header .site-header__cta {
    background-color: var(--color-brand);
    color: var(--color-paper);
  }
  .site-header .site-header__cta-radial {
    background-color: var(--color-paper);
  }
  .site-header .site-header__cta:hover {
    color: var(--color-brand);
    border-color: var(--color-brand);
  }
  .site-header .site-header__menu-btn {
    color: var(--color-ink);
  }

  /* ---------- HERO HEADER (em fluxo, abre a home acima do hero) ---------- */
  .site-header--hero {
    position: relative;
    z-index: 20;
  }

  /* ---------- STICKY HEADER (fixa, entra de cima na rolagem) ---------- */
  .site-header--sticky {
    position: fixed;
    top: 0;
    z-index: 40;
    opacity: 0;
    transform: translateY(-100%);
    transition:
      transform 600ms cubic-bezier(0.43, 0.46, 0.64, 0.66),
      opacity 600ms cubic-bezier(0.43, 0.46, 0.64, 0.66);
    will-change: transform, opacity;
  }
  .site-header--sticky[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
  }

  /* Shared transitions */
  .site-header__nav-link {
    transition: color 200ms ease;
  }
  .site-header__cta {
    border: 2px solid transparent;
    transition: color 600ms ease, border-color 600ms ease;
  }
  .site-header__menu-btn {
    transition: color 200ms ease;
  }

  /* Dot indicator below each nav item */
  .site-header__nav-dot {
    width: 4px;
    height: 4px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.3;
    transform: scale(0.85);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .site-header__nav-link:hover .site-header__nav-dot {
    opacity: 0.6;
  }
  .site-header__nav-link[data-active] .site-header__nav-dot {
    opacity: 1;
    transform: scale(1);
    box-shadow:
      0 0 6px rgba(31, 107, 58, 0.55),
      0 0 12px rgba(31, 107, 58, 0.28);
  }

  /* Ícone do hambúrguer: barras fechado, X aberto */
  .site-header__menu-icon-x {
    display: none;
  }
  .site-header__menu-btn[aria-expanded="true"] .site-header__menu-icon-bars {
    display: none;
  }
  .site-header__menu-btn[aria-expanded="true"] .site-header__menu-icon-x {
    display: block;
  }

  /* ===========================================================
     Menu mobile: camada fixa abaixo do header. O backdrop escurece e
     desfoca a página; o painel flutua como um cartão de vidro fosco.
     `hidden` no wrapper controla a visibilidade (script abaixo).
     =========================================================== */
  .site-mobile-menu {
    position: fixed;
    inset: 0;
    top: var(--site-header-h);
    z-index: 35;
  }
  .site-mobile-menu__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(20, 19, 17, 0.42);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    animation: menu-backdrop-in 240ms ease-out both;
  }
  .site-mobile-menu__panel {
    position: absolute;
    top: 0.75rem;
    left: 1rem;
    right: 1rem;
    max-height: calc(100% - 1.5rem);
    overflow-y: auto;
    padding: 0.5rem;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.75);
    background-color: rgba(255, 255, 255, 0.86);
    -webkit-backdrop-filter: blur(20px) saturate(1.4);
    backdrop-filter: blur(20px) saturate(1.4);
    box-shadow:
      0 24px 60px -24px rgba(20, 19, 17, 0.45),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    transform-origin: top center;
    animation: menu-panel-in 320ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  /* Filete da marca no topo do cartão */
  .site-mobile-menu__panel::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.5rem;
    right: 1.5rem;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: linear-gradient(
      90deg,
      var(--color-brand),
      var(--color-brand-tint)
    );
  }
  @supports not (backdrop-filter: blur(1px)) {
    .site-mobile-menu__panel {
      background-color: rgba(255, 255, 255, 0.98);
    }
  }
  /* Tablet: o cartão encosta à direita, sob o hambúrguer */
  @media (min-width: 640px) {
    .site-mobile-menu__panel {
      left: auto;
      width: min(24rem, calc(100% - 2rem));
    }
  }
  .site-mobile-menu__list {
    padding-top: 0.25rem;
  }
  .site-mobile-menu__item {
    animation: menu-item-in 360ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: calc(60ms + var(--i, 0) * 45ms);
  }
  .site-mobile-menu__item + .site-mobile-menu__item {
    border-top: 1px solid rgba(20, 19, 17, 0.06);
  }
  .site-mobile-menu__cta {
    padding: 0.75rem 0.5rem 0.25rem;
  }
  .site-mobile-menu__lang {
    margin-top: 0.5rem;
    padding: 0.875rem 1rem 0.375rem;
  }

  /* Links: ponto da marca marca a seção ativa (scroll spy) */
  .site-mobile-link {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding: 0.875rem 1rem;
    border-radius: 0.875rem;
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    transition:
      background-color 180ms ease,
      color 180ms ease;
  }
  .site-mobile-link__dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background-color: var(--color-brand);
    opacity: 0;
    transform: scale(0.5);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .site-mobile-link__label {
    flex: 1;
  }
  .site-mobile-link__arrow {
    color: var(--color-ink-muted);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 180ms ease,
      transform 180ms ease;
  }
  .site-mobile-link:hover,
  .site-mobile-link:focus-visible {
    background-color: rgba(2, 92, 0, 0.06);
    outline: none;
  }
  .site-mobile-link:focus-visible {
    box-shadow: 0 0 0 2px var(--color-brand);
  }
  .site-mobile-link:hover .site-mobile-link__arrow,
  .site-mobile-link:focus-visible .site-mobile-link__arrow {
    opacity: 1;
    transform: translateX(0);
  }
  .site-mobile-link[data-active] {
    color: var(--color-brand);
    font-weight: 600;
  }
  .site-mobile-link[data-active] .site-mobile-link__dot {
    opacity: 1;
    transform: scale(1);
    box-shadow: 0 0 0 4px rgba(2, 92, 0, 0.12);
  }

  @keyframes menu-backdrop-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes menu-panel-in {
    from {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes menu-item-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-mobile-menu__backdrop,
    .site-mobile-menu__panel,
    .site-mobile-menu__item {
      animation: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header--sticky {
      transition: none;
      transform: none;
    }
    .site-header--sticky[data-visible="true"] {
      transform: none;
    }
  }
</style>

<script>
  // ---------- Scroll-aware sticky header (slides in past hero) ----------
  const stickyHeader = document.querySelector<HTMLElement>(
    "[data-header-sticky]"
  );
  const scrollAware = stickyHeader?.dataset.scrollAware === "true";
  const heroHeader = document.querySelector<HTMLElement>("[data-header-hero]");

  if (stickyHeader && scrollAware && heroHeader) {
    const getThreshold = () => {
      const rect = heroHeader.getBoundingClientRect();
      return rect.bottom + window.scrollY;
    };

    let threshold = getThreshold();

    const applyStickyVisibility = () => {
      const visible = window.scrollY > threshold;
      const current = stickyHeader.dataset.visible === "true";
      if (visible !== current) {
        stickyHeader.dataset.visible = visible ? "true" : "false";
        stickyHeader.toggleAttribute("inert", !visible);
        stickyHeader.setAttribute("aria-hidden", String(!visible));
      }
    };

    let stickyTicking = false;
    const onScrollSticky = () => {
      if (!stickyTicking) {
        requestAnimationFrame(() => {
          applyStickyVisibility();
          stickyTicking = false;
        });
        stickyTicking = true;
      }
    };

    window.addEventListener("scroll", onScrollSticky, { passive: true });
    window.addEventListener("resize", () => {
      threshold = getThreshold();
      applyStickyVisibility();
    });

    applyStickyVisibility();
  }

  // ---------- Mobile menu toggle ----------
  const toggles = document.querySelectorAll<HTMLButtonElement>(
    ".js-menu-toggle"
  );
  const menu = document.getElementById("mobile-menu");

  const setMenuState = (open: boolean) => {
    if (!menu) return;
    if (open) menu.removeAttribute("hidden");
    else menu.setAttribute("hidden", "");
    // Página não rola atrás do menu aberto
    document.documentElement.style.overflow = open ? "hidden" : "";
    toggles.forEach((btn) => {
      btn.setAttribute("aria-expanded", String(open));
      // Labels traduzidos vêm via data-attr setado pelo template (locale-aware)
      const label = open
        ? btn.dataset.labelClose ?? "Close menu"
        : btn.dataset.labelOpen ?? "Open menu";
      btn.setAttribute("aria-label", label);
    });
  };

  toggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const isOpen = menu && !menu.hasAttribute("hidden");
      setMenuState(!isOpen);
    });
  });

  const isMenuOpen = () => Boolean(menu && !menu.hasAttribute("hidden"));

  // Clique fora do painel (backdrop, header ou qualquer área) fecha.
  // O próprio botão fica de fora: ele já alterna o estado acima.
  document.addEventListener("click", (event) => {
    if (!isMenuOpen()) return;
    const target = event.target as Element | null;
    if (!target) return;
    if (
      target.closest(".site-mobile-menu__panel") ||
      target.closest(".js-menu-toggle")
    ) {
      return;
    }
    setMenuState(false);
  });

  // Esc fecha e devolve o foco ao hambúrguer visível
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !isMenuOpen()) return;
    setMenuState(false);
    const visibleToggle = Array.from(toggles).find(
      (btn) => btn.getClientRects().length > 0
    );
    visibleToggle?.focus();
  });

  // Virou desktop (lg) com o menu aberto: fecha e libera a rolagem
  const desktopQuery = window.matchMedia("(min-width: 1024px)");
  desktopQuery.addEventListener("change", (event) => {
    if (event.matches && isMenuOpen()) setMenuState(false);
  });

  // ---------- Scroll spy (active state across all nav variants) ----------
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]")
  );

  const getAnchorId = (link: HTMLAnchorElement): string | null => {
    const href = link.getAttribute("href") ?? "";
    const match = href.match(/#([\w-]+)$/);
    return match ? match[1] : null;
  };

  const idToLinks = new Map<string, HTMLAnchorElement[]>();
  navLinks.forEach((link) => {
    const id = getAnchorId(link);
    if (!id) return;
    if (!idToLinks.has(id)) idToLinks.set(id, []);
    idToLinks.get(id)!.push(link);
  });

  const sections: HTMLElement[] = [];
  idToLinks.forEach((_, id) => {
    const el = document.getElementById(id);
    if (el) sections.push(el);
  });

  let activeId: string | null = null;

  const setActiveId = (id: string | null) => {
    if (id === activeId) return;
    activeId = id;
    idToLinks.forEach((links, sectionId) => {
      links.forEach((link) => {
        if (sectionId === id) {
          link.setAttribute("data-active", "true");
          link.setAttribute("aria-current", "true");
        } else {
          link.removeAttribute("data-active");
          link.removeAttribute("aria-current");
        }
      });
    });
  };

  const updateActive = () => {
    const triggerLine = 100; // ~sticky header height + breathing room
    let bestId: string | null = null;
    let bestTop = -Infinity;
    sections.forEach((section) => {
      const top = section.getBoundingClientRect().top - triggerLine;
      if (top <= 0 && top > bestTop) {
        bestTop = top;
        bestId = section.id;
      }
    });
    setActiveId(bestId);
  };

  let activeTicking = false;
  const onScrollActive = () => {
    if (!activeTicking) {
      requestAnimationFrame(() => {
        updateActive();
        activeTicking = false;
      });
      activeTicking = true;
    }
  };
  window.addEventListener("scroll", onScrollActive, { passive: true });
  window.addEventListener("resize", updateActive);
  updateActive();

  // ---------- Close mobile menu on link click ----------
  // Qualquer link do painel fecha o menu: seções, CTA "Solicitar serviço" e
  // idiomas. A rolagem suave do BaseLayout roda depois, no document.
  menu?.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((link) => {
    link.addEventListener("click", () => {
      if (isMenuOpen()) setMenuState(false);
    });
  });
</script>
