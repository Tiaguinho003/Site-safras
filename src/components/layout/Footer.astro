---
import { Image } from "astro:assets";
import logoBranco from "../../assets/branding/safras-logo-branco.png";
import lavouraAerea from "../../assets/about/lavoura-aerea.png";
import { mainNav } from "../../data/navigation";
import { useTranslation } from "../../i18n";

const { t, localizeAnchor, route } = useTranslation(Astro);
const currentYear = new Date().getFullYear();

const servicesHref = localizeAnchor("servicos");
// Slug traduzido por idioma — /privacidade, /en/privacy, /es/privacidad.
const privacyHref = route("privacidade");
const publicEmail = t("contact.details.email");
const publicPhone = t("contact.details.phone");
const whatsappHref = `https://wa.me/5535984617193?text=${encodeURIComponent(
  t("contact.whatsappPrefill"),
)}`;

// Cada link da coluna "Serviços" no footer aponta pra um dos cards
// da seção #servicos. Reusamos as chaves do dict pra manter consistência
// com o conteúdo da homepage.
const servicesLinks: { dictKey: string; href: string }[] = [
  { dictKey: "services.cards.mercadoNegociacao.title", href: servicesHref },
  { dictKey: "services.cards.analiseQualidade.title", href: servicesHref },
  { dictKey: "services.cards.suporteLogistico.title", href: servicesHref },
];

/**
 * `evento` marca o link para a medição de conversão. É o atributo, e não o
 * padrão do href, que define o que conta — mais abaixo, no crédito
 * "desenvolvido por", há um `wa.me` que é o contato do desenvolvedor e
 * jamais pode ser contado como lead do cliente.
 *
 * O Instagram fica sem evento: não está no vocabulário da §7 do plano de
 * ecossistema, e inventar um nome aqui furaria o contrato.
 */
const contactLinks: {
  label: string;
  href: string;
  external: boolean;
  evento?: string;
}[] = [
  {
    label: publicEmail,
    href: `mailto:${publicEmail}`,
    external: false,
    evento: "contato_email",
  },
  {
    label: publicPhone,
    href: "tel:+5535984617193",
    external: false,
    evento: "contato_telefone",
  },
  {
    label: "Instagram",
    href: "https://instagram.com/safrasnegocios",
    external: true,
  },
  {
    label: "WhatsApp",
    href: whatsappHref,
    external: true,
    evento: "contato_whatsapp",
  },
];
---

<footer class="relative overflow-hidden bg-brand-dark text-paper">
  {/* Foto aérea da lavoura: aparece inteira no topo e anoitece para o verde
      da marca onde ficam a logo e as colunas. */}
  <Image
    src={lavouraAerea}
    alt=""
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    class="absolute inset-0 h-full w-full object-cover object-[50%_30%]"
    loading="lazy"
    fetchpriority="low"
    quality={60}
  />

  {/* Anoitecer: verde da marca subindo até um preto quente na base */}
  <div
    aria-hidden="true"
    class="absolute inset-0 pointer-events-none z-10"
    style="background: linear-gradient(180deg, rgba(1,61,1,0) 0%, rgba(1,61,1,0.5) 16%, rgba(1,61,1,0.78) 30%, rgba(8,38,10,0.9) 62%, rgba(20,19,17,0.96) 100%);"
  ></div>

  {/* TOPO: fade curto a partir do branco da seção anterior */}
  <div
    aria-hidden="true"
    class="absolute inset-x-0 top-0 h-36 md:h-48 lg:h-56 bg-gradient-to-b from-paper via-paper/55 to-transparent pointer-events-none z-10"
  ></div>

  <div class="relative z-20 max-w-[100rem] mx-auto px-6 md:px-10 pt-40 md:pt-52 lg:pt-60 pb-[3.6rem] md:pb-[4.5rem] lg:pb-[5.4rem]">
    {/* ====== Logo branca + tagline, sobre uma sombra radial ====== */}
    <div class="relative text-center">
      <div
        aria-hidden="true"
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[min(100%,44rem)] h-[170%] rounded-full bg-[radial-gradient(ellipse_at_center,rgba(4,26,6,0.6),transparent_70%)] pointer-events-none"
      ></div>
      <Image
        src={logoBranco}
        alt={t("brand.logoAlt")}
        widths={[240, 340, 480, 680]}
        sizes="(min-width: 1024px) 340px, (min-width: 768px) 290px, 230px"
        class="relative mx-auto h-auto w-[230px] md:w-[290px] lg:w-[340px] drop-shadow-[0_14px_36px_rgba(0,0,0,0.45)]"
        loading="lazy"
        fetchpriority="low"
      />
      <p class="relative mt-5 md:mt-6 text-sm md:text-[15px] tracking-[0.03em] text-brand-tint">
        {t("footer.tagline")}
      </p>
    </div>

    {/* Linha que desaparece nas pontas */}
    <div
      aria-hidden="true"
      class="mt-12 md:mt-16 lg:mt-20 h-px bg-gradient-to-r from-transparent via-paper/30 to-transparent"
    ></div>

    {/* ====== 3 colunas ====== */}
    <div
      class="mt-10 md:mt-14 grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12 lg:gap-16 max-w-5xl mx-auto"
    >
      {/* Col 1: Serviços (escondido no mobile) */}
      <nav aria-label={t("footer.columns.services")} class="hidden md:block">
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-tint mb-5">
          {t("footer.columns.services")}
        </h2>
        <ul class="space-y-3">
          {
            servicesLinks.map((s) => (
              <li>
                <a
                  href={s.href}
                  class="text-[15px] text-paper/75 hover:text-paper transition-colors"
                >
                  {t(s.dictKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Col 2: Navegação */}
      <nav aria-label={t("footer.columns.navigation")}>
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-tint mb-5">
          {t("footer.columns.navigation")}
        </h2>
        <ul class="space-y-3">
          {
            mainNav.map((item) => (
              <li>
                <a
                  href={localizeAnchor(item.anchor)}
                  class="text-[15px] text-paper/75 hover:text-paper transition-colors"
                >
                  {t(item.labelKey)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* Col 3: Contato */}
      <nav aria-label={t("footer.columns.contact")}>
        <h2 class="text-[11px] font-semibold uppercase tracking-[0.22em] text-brand-tint mb-5">
          {t("footer.columns.contact")}
        </h2>
        <ul class="space-y-3">
          {
            contactLinks.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.external ? "_blank" : undefined}
                  rel={s.external ? "noopener noreferrer" : undefined}
                  data-contato={s.evento}
                  data-origem={s.evento ? "rodape" : undefined}
                  class="text-[15px] text-paper/75 hover:text-paper transition-colors max-md:wrap-anywhere"
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    {/* ====== Bottom row ====== */}
    <div
      class="mt-10 md:mt-20 pt-5 md:pt-8 border-t border-paper/15 flex flex-col md:flex-row items-start md:items-center justify-between gap-4 text-xs text-paper/60"
    >
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
        <span>© {currentYear} {t("brand.name")}. {t("footer.copyright")}</span>
        <span class="hidden md:inline text-paper/30" aria-hidden="true">·</span>
        <a
          href={privacyHref}
          class="underline underline-offset-4 decoration-paper/30 hover:text-paper hover:decoration-paper/60 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
        >
          {t("footer.privacy")}
        </a>
        <span class="hidden md:inline text-paper/30" aria-hidden="true">·</span>
        {/* Reabre o painel de consentimento. É um <button> porque abre uma
            interface, não navega. Revogar precisa ser tão fácil quanto
            consentir — sem este ponto de entrada, a primeira escolha viraria
            definitiva na prática. */}
        <button
          type="button"
          data-consent-open
          class="underline underline-offset-4 decoration-paper/30 hover:text-paper hover:decoration-paper/60 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
        >
          {t("consent.footerLink")}
        </button>
      </p>
      <div class="flex items-center gap-5">
        <button
          type="button"
          data-scroll-top
          class="inline-flex items-center gap-1.5 hover:text-paper transition-colors"
          aria-label={t("footer.backToTopAriaLabel")}
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 19V5M5 12l7-7 7 7"></path>
          </svg>
          {t("footer.backToTop")}
        </button>
      </div>
    </div>

    {/* ====== Credits row ====== */}
    <div class="mt-5 md:mt-6 pt-4 md:pt-5 border-t border-paper/10 text-center">
      {/* Contato do desenvolvedor. Sem `data-contato` de propósito: clique
          aqui não é lead do cliente e não pode entrar na medição. */}
      <a
        href="https://wa.me/5511910784384"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block text-xs text-paper/55 hover:text-paper/85 transition-colors"
      >
        {t("footer.developedBy")} <span class="font-semibold text-paper/80 underline underline-offset-4 decoration-paper/30">{t("footer.developerName")}</span>
      </a>
    </div>
  </div>
</footer>

<script>
  // Back-to-top — usa o helper de rolagem nativa do BaseLayout
  document
    .querySelectorAll<HTMLButtonElement>("[data-scroll-top]")
    .forEach((btn) => {
      btn.addEventListener("click", () => {
        const smooth = (
          window as Window & {
            __smoothScrollTo?: (target: HTMLElement | number) => void;
          }
        ).__smoothScrollTo;
        if (smooth) {
          smooth(0);
        } else {
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      });
    });
</script>
