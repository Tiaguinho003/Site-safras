---
/**
 * HomePage — single source of truth pro conteúdo da home em qualquer idioma.
 *
 * Usado por:
 * - src/pages/index.astro       (PT-BR, /)
 * - src/pages/en/index.astro    (EN, /en/)
 * - src/pages/es/index.astro    (ES, /es/)
 *
 * Todas as 3 rotas renderizam ESTE componente. O locale vem de
 * Astro.currentLocale automaticamente.
 *
 * Strings vêm do dicionário (src/i18n/*.ts) via useTranslation().
 * Anchors/IDs de seção vêm de anchors.ts (servicos→services/servicios, etc.).
 */
import { getImage, Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import HeroSection from "../sections/HeroSection.astro";
import ContactSection from "../sections/ContactSection.astro";
import { useTranslation, getAnchor } from "../../i18n";

import fachadaSafras from "../../assets/hero/fachada-safras.jpg";
import saoSebastiaoParaiso from "../../assets/about/sao-sebastiao-paraiso.png";
import lavouraCafeAerea from "../../assets/about/lavoura-cafe-aerea.png";
import analiseQualidadeImg from "../../assets/services/analise-qualidade.jpg";
import mercadoNegociacaoImg from "../../assets/services/mercado-negociacao.jpg";
import suporteLogisticoImg from "../../assets/services/suporte-logistico.jpg";

const { t, tArray, locale } = useTranslation(Astro);
const baseUrl = Astro.site ?? new URL("https://safrasenegocios.com.br");
const socialImage = await getImage({
  src: fachadaSafras,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpg",
  quality: 85,
});
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Safras & Negócios",
  url: new URL(locale === "pt-br" ? "/" : `/${locale}`, baseUrl).href,
  image: new URL(socialImage.src, baseUrl).href,
  email: "atendimento@safrasnegocios.com.br",
  telephone: "+55 35 98461-7193",
  foundingDate: "2015-10-19",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Av. Oliveira Rezende, 1397 — Jardim Bernadete",
    addressLocality: "São Sebastião do Paraíso",
    addressRegion: "MG",
    addressCountry: "BR",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "https://schema.org/Monday",
      "https://schema.org/Tuesday",
      "https://schema.org/Wednesday",
      "https://schema.org/Thursday",
      "https://schema.org/Friday",
    ],
    opens: "08:00",
    closes: "18:00",
  },
};

// IDs de seção localizados (#servicos em PT, #services em EN, #servicios em ES)
const servicosId = getAnchor("servicos", locale);
const quemSomosId = getAnchor("quem-somos", locale);

// ===== Dados estruturais (não-traduzíveis: ícones/imagens/posições) =====
// As strings vivem no dicionário; cada item tem uma `key` que mapeia
// pra `dict.<section>.cards.<key>.*`

const statsCards = [
  {
    type: "city" as const,
    position: "top" as const,
    dictPath: "about.stats.city",
  },
  {
    type: "counter" as const,
    target: 2015,
    position: "bottom" as const,
    dictPath: "about.stats.years",
  },
];

const differentialsData = [
  {
    key: "historia",
    iconSvg: `<path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /><path d="M12 7v5l4 2" />`,
  },
  {
    key: "missao",
    iconSvg: `<circle cx="12" cy="12" r="10" /><circle cx="12" cy="12" r="6" /><circle cx="12" cy="12" r="2" />`,
  },
  {
    key: "visao",
    iconSvg: `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" /><circle cx="12" cy="12" r="3" />`,
  },
  {
    key: "valores",
    iconSvg: `<circle cx="12" cy="12" r="10" /><path d="m16.24 7.76-1.804 5.411a2 2 0 0 1-1.265 1.265L7.76 16.24l1.804-5.411a2 2 0 0 1 1.265-1.265z" />`,
  },
];

interface ValoresItem {
  name: string;
  body: string;
}
const valoresLead = t("principles.cards.valores.lead");
const valoresItems = tArray<ValoresItem>("principles.cards.valores.items");

const servicesData = [
  {
    key: "mercadoNegociacao",
    iconSvg: `<path d="m11 17 2 2a1 1 0 1 0 3-3" /><path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4" /><path d="m21 3 1 11h-2" /><path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3" /><path d="M3 4h8" />`,
    image: mercadoNegociacaoImg,
    imagePosition: "50% 45%",
  },
  {
    key: "analiseQualidade",
    iconSvg: `<path d="M17 8h1a4 4 0 1 1 0 8h-1" /><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" /><line x1="6" x2="6" y1="2" y2="4" /><line x1="10" x2="10" y1="2" y2="4" /><line x1="14" x2="14" y1="2" y2="4" />`,
    image: analiseQualidadeImg,
    imagePosition: "55% 40%",
  },
  {
    key: "suporteLogistico",
    iconSvg: `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" /><path d="M15 18H9" /><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14" /><circle cx="17" cy="18" r="2" /><circle cx="7" cy="18" r="2" />`,
    image: suporteLogisticoImg,
    imagePosition: "50% 45%",
  },
];

// SVG-friendly tokens em arrays do dict (split-text title lines)
const servicesTitleLines = tArray<string[]>("services.titleLines");
const aboutTitleLines = tArray<string[]>("about.titleLines");
const principlesTitleLines = tArray<string[]>("principles.titleLines");

// Pré-computa estruturas de spans dos títulos split-text — evita JSX
// com .map() aninhado e ternários complexos que confundem o parser.
const servicesTitle = servicesTitleLines.map((line, lineIdx) => {
  const baseDelay = lineIdx === 0 ? 0 : lineIdx === 1 ? 80 : 240;
  const spans = line.map((word, wordIdx) => {
    const delay = baseDelay + wordIdx * 80;
    const isHighlight =
      lineIdx === servicesTitleLines.length - 1 &&
      wordIdx === line.length - 1;
    const alignTop = lineIdx === 2 && !isHighlight;
    let className = "split-text-word";
    if (isHighlight) {
      className =
        "split-text-word text-brand text-3xl md:text-4xl lg:text-5xl xl:text-6xl relative";
    } else if (alignTop) {
      className = "split-text-word align-top";
    }
    const styleStr = isHighlight
      ? "transition-delay: " + delay + "ms; top: -0.1em; left: 0.05em;"
      : "transition-delay: " + delay + "ms;";
    return { word, className, styleStr };
  });
  return { spans };
});

const aboutTitle = aboutTitleLines.map((line, lineIdx) => {
  const baseDelay = lineIdx === 0 ? 0 : 240;
  const spans = line.map((word, wordIdx) => {
    const delay = baseDelay + wordIdx * 80;
    const isHighlight = lineIdx === 0 && wordIdx === 0;
    const className = isHighlight
      ? "split-text-word text-brand"
      : "split-text-word";
    const styleStr = "transition-delay: " + delay + "ms;";
    return { word, className, styleStr };
  });
  return { spans };
});

const principlesTitle = principlesTitleLines.map((line, lineIdx) => {
  const baseDelay = lineIdx === 0 ? 0 : 80;
  const spans = line.map((word, wordIdx) => {
    const delay = baseDelay + wordIdx * 80;
    const isHighlight = lineIdx === principlesTitleLines.length - 1;
    const className = isHighlight
      ? "split-text-word text-brand"
      : "split-text-word";
    const styleStr = "transition-delay: " + delay + "ms;";
    return { word, className, styleStr };
  });
  return { spans };
});
---

<BaseLayout
  title={t("meta.siteTitle")}
  description={t("meta.siteDescription")}
  socialImage={socialImage.src}
  socialImageAlt={t("meta.socialImageAlt")}
  socialImageWidth={1200}
  socialImageHeight={630}
  structuredData={localBusinessSchema}
>
  <HeroSection />

  <section
    id={servicosId}
    class="bg-paper scroll-mt-[70px] md:scroll-mt-[90px]"
    aria-labelledby="servicos-titulo"
  >
    <div class="max-w-[88rem] mx-auto px-6 md:px-10 py-20 md:py-28 lg:py-32 pb-14 md:pb-20 lg:pb-24">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 mb-20 md:mb-28 lg:mb-32"
      >
        <div>
          <div class="flex items-start gap-6 md:gap-10 lg:gap-14 overflow-x-clip">
            <div class="flex flex-col items-start shrink-0 gap-6 w-[100px] md:w-auto">
              <span
                class="inline-block text-xs font-semibold uppercase tracking-[0.22em] text-brand whitespace-nowrap shrink-0 mt-2 md:mt-3 lg:-mt-8"
              >
                {t("services.sectionLabel")}
              </span>

              <div
                class="coffee-bean-float relative w-[100px] h-[100px] md:w-[120px] md:h-[120px] text-brand"
                aria-hidden="true"
              >
                <div class="coffee-bean-tilt w-full h-full">
                  <svg
                    viewBox="0 0 160 160"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-full h-full"
                  >
                    <g transform="rotate(8 80 80)">
                      <ellipse cx="80" cy="80" rx="36" ry="52" stroke-width="2.5" />
                      <path d="M 80 30 C 98 48, 98 112, 80 130" stroke-width="2" />
                      <path d="M 80 33 C 93 55, 73 105, 80 127" stroke-width="1.8" />
                      <path d="M 80 33 C 87 55, 67 105, 80 127" stroke-width="1.8" />
                    </g>
                  </svg>
                </div>
              </div>
            </div>
            <h2
              id="servicos-titulo"
              data-reveal="split-text"
              class="split-text min-w-0 wrap-anywhere text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-medium text-ink leading-[1.05] tracking-[-0.03em] mt-12 md:mt-0 lg:-mt-8"
            >
              {servicesTitle.map((titleLine) => (
                <span class="block">
                  {titleLine.spans.flatMap((s, i) =>
                    i === 0
                      ? [<span class={s.className} style={s.styleStr}>{s.word}</span>]
                      : [" ", <span class={s.className} style={s.styleStr}>{s.word}</span>]
                  )}
                </span>
              ))}
            </h2>
          </div>
        </div>

        <div class="lg:-mt-8 max-w-xl fade-in-up" data-reveal="fade-in-up">
          <p class="text-xl md:text-2xl lg:text-3xl text-ink/50 leading-[1.33]">
            {t("services.intro.part1")}{" "}
            <span class="text-brand font-medium">
              {t("services.intro.highlight")}
            </span>{" "}
            {t("services.intro.part2")}
          </p>
          <div
            aria-hidden="true"
            class="mt-8 md:mt-10 h-px lg:h-0.5 w-full bg-ink opacity-20"
          ></div>
        </div>
      </div>

      <div
        id="servicos-accordion"
        class="flex flex-col lg:flex-row gap-5 lg:gap-6 lg:h-[470px]"
      >
        {servicesData.map((service, idx) => {
          const number = t(`services.cards.${service.key}.number`);
          const title = t(`services.cards.${service.key}.title`);
          const imageAlt = t(`services.cards.${service.key}.imageAlt`);
          const description = t(`services.cards.${service.key}.description`);
          // Frentes do serviço viram fichas no painel. A quebra de linha do
          // dict era para as tiras antigas; aqui vira espaço.
          const strips = tArray(`services.cards.${service.key}.strips`).map(
            (strip) => strip.replace(/\n/g, " "),
          );
          return (
            <article
              data-service-card
              data-scroll-active-card="md"
              data-active={idx === 0 ? "true" : "false"}
              class="group relative overflow-hidden rounded-2xl bg-paper-alt border border-dashed border-line cursor-pointer flex flex-col flex-1 lg:flex-[1_1_0%] data-[active=true]:lg:flex-[3_1_0%] data-[active=true]:border-solid data-[active=true]:border-line min-h-[340px] md:min-h-[320px] lg:min-h-0 lg:h-full transition-[flex,border-color] duration-500 ease-[cubic-bezier(0.29,0,0.2,1)] focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-4"
              tabindex="0"
              aria-label={`${number}: ${title}`}
            >
              <Image
                src={service.image}
                alt={imageAlt}
                widths={[400, 640, 768, 960, 1200]}
                sizes="(min-width: 1024px) 56vw, 100vw"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-[900ms] ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[active=true]:scale-[1.03]"
                style={`object-position: ${service.imagePosition};`}
                loading="lazy"
                fetchpriority="low"
                quality={62}
              />

              {/* Véu claro do cartão compacto — some quando ativo */}
              <div
                aria-hidden="true"
                class="absolute inset-0 bg-paper-alt/70 transition-opacity duration-[400ms] ease-[cubic-bezier(0.48,0,0.11,1)] group-data-[active=true]:opacity-0"
              />

              {/* Sombras do cartão ativo: no topo, para o título ler bem sobre a
                  foto; na base, profundidade sob o painel. O meio fica livre. */}
              <div
                aria-hidden="true"
                class="absolute inset-0 opacity-0 transition-opacity duration-[400ms] ease-[cubic-bezier(0.48,0,0.11,1)] group-data-[active=true]:opacity-100"
                style="background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0) 38%, rgba(0,0,0,0) 62%, rgba(0,0,0,0.4) 100%);"
              />

              {/* flex-1 preenche a altura mínima do card empilhado; assim o painel
                  fica na base e a foto aparece entre ele e o título. */}
              <div class="relative flex-1 lg:h-full p-4 md:p-5 flex flex-col justify-between gap-4">
                {/* Topo: ícone, número e título. Título ao lado do ícone; só no lg,
                    onde o cartão compacto é estreito, ele desce para baixo do ícone. */}
                <div class="flex items-start gap-3 lg:flex-col xl:flex-row xl:gap-4">
                  <div
                    class="w-11 h-11 md:w-12 md:h-12 rounded-xl flex items-center justify-center bg-ink text-paper group-data-[active=true]:bg-paper group-data-[active=true]:text-[#8b5e34] transition-colors duration-[400ms] ease-[cubic-bezier(0.48,0,0.11,1)] shrink-0"
                    aria-hidden="true"
                  >
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="22"
                      height="22"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={service.iconSvg}
                    />
                  </div>
                  <div class="min-w-0 pt-0.5 lg:pt-0 xl:pt-0.5">
                    <span
                      aria-hidden="true"
                      class="flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.22em] text-brand transition-colors duration-[400ms] group-data-[active=true]:text-brand-tint"
                    >
                      {number}
                      <span class="h-px w-6 bg-current opacity-70"></span>
                    </span>
                    <h3 class="service-card__title mt-1 font-medium text-ink transition-[color,font-size,letter-spacing] duration-500 ease-[cubic-bezier(0.29,0,0.2,1)] group-data-[active=true]:text-paper">
                      {title}
                    </h3>
                  </div>
                </div>

                {/* Base: painel de detalhes — recolhido no cartão compacto, abre em
                    vidro escuro quando ativo. Descrição e fichas lado a lado no xl;
                    até lá as fichas ficam numa linha rolável. */}
                <div class="service-details">
                  <div class="service-details__clip">
                    <div class="service-details__panel rounded-xl border border-white/15 bg-ink/45 p-3.5 md:p-4 backdrop-blur-xl">
                      <div class="xl:flex xl:items-start xl:gap-6">
                        <p class="text-[14px] md:text-[14.5px] lg:text-[15px] leading-[1.5] text-paper/90 xl:flex-1">
                          {description}
                        </p>
                        <ul
                          class="service-details__chips mt-2.5 flex gap-1.5 xl:mt-0 xl:w-[54%] xl:shrink-0 xl:justify-end"
                          role="list"
                        >
                          {strips.map((strip) => (
                            <li class="shrink-0 whitespace-nowrap inline-flex items-center rounded-full border border-white/25 bg-white/10 px-2.5 py-1 text-[11.5px] md:text-[12px] font-medium text-paper/95">
                              {strip}
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {/* Divider sutil entre Serviços e Sobre nós */}
  <div class="bg-paper">
    <div class="max-w-[88rem] mx-auto px-6 md:px-10">
      <div aria-hidden="true" class="h-px bg-line"></div>
    </div>
  </div>

  <section
    id={quemSomosId}
    class="bg-paper scroll-mt-[70px] md:scroll-mt-[90px]"
    aria-labelledby="quem-somos-titulo"
  >
    <div class="max-w-[88rem] mx-auto px-6 md:px-10 pt-14 md:pt-20 lg:pt-24">
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-4 lg:gap-6 mb-10 md:mb-14 lg:mb-20"
      >
        <div>
          <div class="flex items-start gap-6 md:gap-10 lg:gap-14 overflow-x-clip">
            <div class="flex flex-col items-start shrink-0 gap-6 w-[100px] md:w-auto">
              <span
                class="inline-block text-xs font-semibold uppercase tracking-[0.22em] text-brand whitespace-nowrap shrink-0 mt-2 md:mt-3 lg:mt-12"
              >
                {t("about.sectionLabel")}
              </span>

              <div
                class="coffee-bean-float relative w-[100px] h-[100px] md:w-[120px] md:h-[120px] text-brand"
                aria-hidden="true"
              >
                <div class="coffee-bean-tilt w-full h-full">
                  <svg
                    viewBox="0 0 160 160"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-full h-full"
                  >
                    <g transform="rotate(8 80 80)">
                      <ellipse cx="80" cy="80" rx="36" ry="52" stroke-width="2.5" />
                      <path d="M 80 30 C 98 48, 98 112, 80 130" stroke-width="2" />
                      <path d="M 80 33 C 93 55, 73 105, 80 127" stroke-width="1.8" />
                      <path d="M 80 33 C 87 55, 67 105, 80 127" stroke-width="1.8" />
                    </g>
                  </svg>
                </div>
              </div>
            </div>

            <h2
              id="quem-somos-titulo"
              data-reveal="split-text"
              class="split-text min-w-0 wrap-anywhere text-2xl md:text-3xl lg:text-4xl xl:text-5xl font-medium text-ink leading-[1.05] tracking-[-0.03em] mt-12 md:mt-0 lg:mt-12"
            >
              {aboutTitle.map((titleLine) => (
                <span class="block">
                  {titleLine.spans.flatMap((s, i) =>
                    i === 0
                      ? [<span class={s.className} style={s.styleStr}>{s.word}</span>]
                      : [" ", <span class={s.className} style={s.styleStr}>{s.word}</span>]
                  )}
                </span>
              ))}
            </h2>
          </div>
        </div>

        <div class="lg:mt-12 max-w-xl fade-in-up" data-reveal="fade-in-up">
          <p class="text-xl md:text-2xl lg:text-3xl text-ink/50 leading-[1.33]">
            {t("about.intro.part1")}{" "}
            <span class="text-brand font-medium">
              {t("about.intro.highlight")}
            </span>{" "}
            {t("about.intro.part2")}
          </p>
          <div
            aria-hidden="true"
            class="mt-8 md:mt-10 h-px lg:h-0.5 w-full bg-ink opacity-20"
          ></div>
        </div>
      </div>

      {/* ===== Row 2: Stats — cidade (com imagem) + +10 (verde sólido) ===== */}
      <div class="grid grid-cols-1 md:grid-cols-[2.64fr_1fr] gap-3 md:gap-4 lg:gap-5">
        {statsCards.map((stat, i) => {
          const clip =
            i === 0
              ? "polygon(28px 0, 100% 0, 100% 100%, 0 100%, 0 28px)"
              : i === statsCards.length - 1
                ? "polygon(0 0, 100% 0, 100% calc(100% - 28px), calc(100% - 28px) 100%, 0 100%)"
                : null;
          const isCity = stat.type === "city";
          const cityLines: string[] = isCity
            ? (tArray(`${stat.dictPath}.lines`) as string[])
            : [];
          const statLabel = t(`${stat.dictPath}.label`);
          const counterSuffix = !isCity ? t(`${stat.dictPath}.suffix`) : "";
          return (
            <div
              class={`relative overflow-hidden ${isCity ? "min-h-[280px]" : "min-h-[140px]"} md:min-h-[420px] lg:min-h-[500px] shadow-[0_30px_60px_-30px_rgba(20,19,17,0.2)] ${isCity ? "stats-card" : "bg-brand"}`}
              style={clip ? `clip-path: ${clip};` : undefined}
            >
              {isCity && (
                <Image
                  src={saoSebastiaoParaiso}
                  alt=""
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 1024px) 50vw, (min-width: 768px) 50vw, 100vw"
                  class="absolute inset-0 h-full w-full object-cover"
                  loading="lazy"
                  fetchpriority="low"
                  quality={60}
                />
              )}
              {isCity && <div aria-hidden="true" class="absolute inset-0 bg-ink/55" />}
              <div
                class={`relative h-full flex flex-col ${isCity ? "p-8" : "p-6"} md:p-10 lg:p-12 text-paper ${stat.position === "top" ? "justify-start" : "justify-end"} ${!isCity ? "items-end md:items-stretch" : ""}`}
              >
                {isCity ? (
                  <div data-reveal="city-name" class="city-name-wrap">
                    <div class="text-5xl md:text-6xl lg:text-7xl xl:text-8xl leading-[1.05] tracking-[-0.03em] font-normal">
                      {cityLines.map((line, lineIdx) => (
                        <span class="block overflow-hidden">
                          <span
                            class="city-line block"
                            style={`transition-delay: ${lineIdx * 140}ms;`}
                          >
                            {line}
                          </span>
                        </span>
                      ))}
                    </div>
                    <p
