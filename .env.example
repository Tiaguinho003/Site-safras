# Web3Forms — chave pública usada pelo formulário de contato (#contato).
# Obtenha em https://web3forms.com cadastrando o e-mail destinatário.
# Domínio do site deve estar whitelisted no painel do Web3Forms.
PUBLIC_WEB3FORMS_KEY=

# PageSpeed Insights — medição de performance (scripts/measure-psi.mjs).
# Chave criada no projeto GCP site-safras, restrita a pagespeedonline.googleapis.com.
# Gratuita. É credencial: nunca commitar o valor.
PAGESPEED_API_KEY=

# Google Analytics 4 — ID de medição do fluxo de dados Web (G-XXXXXXXXXX).
# Público por design: aparece no HTML de qualquer implementação de GA4.
# Vazia = nenhum script de medição é emitido, e a política de privacidade
# continua declarando que o site não mede audiência. Preencher só depois de
# criar a propriedade.
PUBLIC_GA4_MEASUREMENT_ID=

# Search Console — código da meta tag de verificação de propriedade.
# Obtido em Search Console → adicionar propriedade → método "tag HTML".
# É só o valor do content, não a tag inteira. Vazia = meta não é emitida.
PUBLIC_GSC_VERIFICATION=
