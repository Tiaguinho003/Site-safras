# Web3Forms — chave pública usada pelo formulário de contato (#contato).
# Obtenha em https://web3forms.com cadastrando o e-mail destinatário.
# Domínio do site deve estar whitelisted no painel do Web3Forms.
PUBLIC_WEB3FORMS_KEY=

# PageSpeed Insights — medição de performance (scripts/measure-psi.mjs).
# Chave criada no projeto GCP site-safras, restrita a pagespeedonline.googleapis.com.
# Gratuita. É credencial: nunca commitar o valor.
PAGESPEED_API_KEY=
